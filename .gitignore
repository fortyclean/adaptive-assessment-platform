# OAuth / Google client secrets (never commit; keep outside repo or use CI secrets)
client_secret*.json
**/client_secret*.json

# Environment files may contain production credentials. Keep only sanitized examples tracked.
backend/.env.production

# Local QA captures and machine-readable test event streams are retained locally.
qa-artifacts/
audit-results/*-events*.json

# Android release signing secrets
mobile/android/app/key.properties
mobile/android/app/*.jks

# Generated release artifacts
adaptive-mastery-v*.apk
adaptive-mastery-v*.aab

# Local Flutter analyzer output
mobile/analyze*.log
mobile/*log*.txt
mobile/pubget_log.txt

# Local Android/Kotlin diagnostics
mobile/android/.kotlin/errors/*.log
